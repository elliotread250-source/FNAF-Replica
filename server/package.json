{
  "name": "@fnaf/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/index.js --sourcemap && cp -r src/db/migrations dist/migrations",
    "dev": "tsx watch --tsconfig ../tsconfig.base.json src/index.ts",
    "migrate": "tsx --tsconfig ../tsconfig.base.json src/db/migrateCli.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "9.4.0",
    "@fastify/static": "7.0.4",
    "@fnaf/shared": "1.0.0",
    "@node-rs/argon2": "2.0.2",
    "drizzle-orm": "0.38.3",
    "fastify": "4.29.1",
    "nodemailer": "6.9.16",
    "postgres": "3.4.5",
    "socket.io": "4.8.1",
    "socket.io-msgpack-parser": "3.0.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/nodemailer": "6.4.17",
    "drizzle-kit": "0.30.1",
    "socket.io-client": "4.8.1"
  }
}
