# Postgres connection string. On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fnaf
# HMAC pepper for session token hashing. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-64-random-hex-chars
# Public origin, required in production (origin checks, email links)
PUBLIC_URL=http://localhost:3000
NODE_ENV=development
# PORT is injected by Railway. Locally it defaults to 3000.
PORT=3000
# tribute (classic names) or original (fully original cast)
ROSTER_MODE=tribute
# 1 = 5-second in-game hours, for testing
FAST_NIGHT=
# Fixed match seed for tests (ignored in production)
TEST_SEED=
# Optional: password reset email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional: TURN server for voice behind strict NATs
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
LOG_LEVEL=info
